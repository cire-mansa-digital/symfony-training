{% extends 'Admin/adminbase.html.twig' %}

{% block title %}Mes Recettes
{% endblock %}

{% block body %}
	<div class="mt-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
		<h1 class="text-5xl font-extrabold text-center text-gray-900 mb-4">
			Mes Recettes
		</h1>
		<p class="text-center text-gray-600 max-w-2xl mx-auto mb-12">
			Découvrez toutes vos recettes préférées. Cliquez sur une recette pour la voir en détail.
		</p>
		<div class="mt-8 text-center flex  mb-2">
			<a href="{{ path('admin.recipe.new') }}" class="inline-flex items-center gap-2 px-6 py-3 bg-amber-600 text-white font-semibold rounded-xl hover:bg-amber-700 transition shadow-lg">
				Créer une nouvelle recette
			</a>
		</div>
		<div class="overflow-hidden rounded-2xl shadow-xl mb-5  bg-white">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-linear-to-r from-amber-500 to-orange-500">
					<tr>
						<th scope="col" class="px-6 py-4 text-left text-sm font-semibold  uppercase tracking-wider">
							Recette
						</th>
						<th scope="col" class="px-6 py-4 text-left text-sm font-semibold  uppercase tracking-wider">
							catégorie
						</th>
						<th scope="col" class="px-6 py-4 text-left text-sm font-semibold  uppercase tracking-wider">
							Durée
						</th>
						<th scope="col" class="px-6 py-4 text-left text-sm font-semibold uppercase tracking-wider">
							Actions
						</th>
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-200">
					{% for recipe in recipes %}
						<tr class="hover:bg-amber-50 transition duration-200">
							<td class="px-6 py-4 whitespace-nowrap">
								<a href="{{ path('admin.recipe.show', {slug: recipe.slug, id: recipe.id}) }}" class="text-lg font-medium text-gray-900 hover:text-amber-600 hover:underline transition">
									{{ recipe.title }}
								</a>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-amber-100 text-amber-800">
									{{ recipe.Category.name | default('')}}

								</span>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-amber-100 text-amber-800">
									{{ recipe.duration }}
									min
								</span>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="flex items-center gap-4">
									<a href="{{ path('admin.recipe.edit', {id: recipe.id}) }}" class="inline-flex  items-center gap-1 px-3 py-1.5 bg-blue-500  text-sm font-medium rounded-lg hover:bg-blue-600 transition shadow-sm">
										Modifier
									</a>
									<form action=" {{ path("admin.recipe.delete", {id:recipe.id}) }} " method="post" >
                                        <input hidden name="_method" value="DELETE" ></input>
										<button onclick="return confirm('Supprimer cette recette ?')" class="inline-flex items-center gap-1 px-3 py-1.5 bg-red-500  text-sm font-medium rounded-lg hover:bg-red-600 transition shadow-sm">
											Supprimer
										</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="3" class="px-6 py-12 text-center text-gray-500">
								<span class="text-4xl block mb-2"></span>
								Aucune recette trouvée.
								<a href="#" class="text-amber-600 hover:underline">Créez-en une !</a>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>

		</div>

            <div class="flex justify-between " >
                {% if page > 1 %}
                     <div>
                        <a class="" href="{{path('admin.recipe.index', {page: page - 1})}}" >Précendent</a>
                     </div>
                {% endif %}
                {% if page < maxPage %}
                     <div>
                        <a href="{{path('admin.recipe.index', {page: page + 1})}}" >Suivant</a>
                     </div>
                {% endif %}
            </div>
	</div>
{% endblock %}
