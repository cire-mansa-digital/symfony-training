{% extends 'Admin/adminbase.html.twig' %}

{% block title %}
    Modifier la recette
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8 mt-16">
        <div class="max-w-4xl mx-auto">
            <div class="text-center mb-6">
                <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900">Modification de la recette</h1>
            </div>

            <div class="mb-4">
                <a href="{{ path('admin.recipe.index') }}" class="text-amber-600 hover:text-amber-800 transition font-medium">
                    ← Retour à la liste des recettes
                </a>
            </div>

            <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
                <div class="bg-gradient-to-r from-amber-600 to-orange-500 px-8 py-4">
                    <h2 class="text-2xl font-semibold text-white">Édition : {{ recipe.title|default('') }}</h2>
                </div>

                <div class="px-8 py-8">
                    {{ form_start(form, { attr: { class: 'space-y-6' } }) }}

                    <div>
                        {{ form_label(form.title, 'Titre de la recette', { label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' } }) }}
                        {{ form_widget(form.title, { attr: { class: 'w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 transition' } }) }}
                        {{ form_errors(form.title) }}
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            {{ form_label(form.slug, 'Slug', { label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' } }) }}
                            {{ form_widget(form.slug, { attr: { class: 'w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 transition bg-gray-50' } }) }}
                            {{ form_errors(form.slug) }}
                        </div>
                        <div>
                            {{ form_label(form.duration, 'Durée (en minutes)', { label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' } }) }}
                            {{ form_widget(form.duration, { attr: { class: 'w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 transition' } }) }}
                            {{ form_errors(form.duration) }}
                        </div>
                    </div>

                    <div>
                        {{ form_label(form.content, 'Contenu de la recette', { label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' } }) }}
                        {{ form_widget(form.content, { attr: { class: 'w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 transition', rows: 6 } }) }}
                        {{ form_errors(form.content) }}
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            {{ form_label(form.category, 'Catégorie', { label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' } }) }}
                            {{ form_widget(form.category, { attr: { class: 'w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 transition' } }) }}
                            {{ form_errors(form.category) }}
                        </div>

                        <div>
                            {{ form_label(form.imageFile, 'Photo de la recette', { label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' } }) }}
                            {{ form_widget(form.imageFile, { attr: { class: 'w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 transition' } }) }}
                            {{ form_errors(form.imageFile) }}

                            {# Affichage de l'image enregistrée si disponible #}
                            {% if recipe is defined and recipe.image %}
                                {% if 'http' in recipe.image %}
                                    <div class="mt-3 flex items-center gap-3">
                                        <img src="{{ recipe.image }}" alt="Aperçu" class="w-20 h-20 object-cover rounded-lg border border-gray-200 shadow-sm">
                                        <span class="text-xs text-gray-500">Image actuelle</span>
                                    </div>
                                {% else %}
                                    <div class="mt-3 flex items-center gap-3">
                                        <img src="{{ vich_uploader_asset(recipe, 'imageFile') }}" alt="Aperçu" class="w-20 h-20 object-cover rounded-lg border border-gray-200 shadow-sm">
                                        <span class="text-xs text-gray-500">Image actuelle</span>
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>


                    {# COLLECTION QUANTITÉS #}
                    <div class="border-t border-gray-200 pt-6">
                        <label class="block text-lg font-semibold text-gray-800 mb-3">Ingrédients & Quantités</label>

                        <div data-controller="form-collection"
                            data-form-collection-add-label-value="Ajouter un ingrédient"
                            data-form-collection-delete-label-value="Supprimer"
                            data-prototype="{{ form_widget(form.quantities.vars.prototype)|e('html_attr') }}"
                            class="space-y-4">

                            {% for quantityForm in form.quantities %}
                                <div class="collection-item p-4 bg-gray-50 rounded-xl border border-gray-200 shadow-sm relative">
                                    {{ form_widget(quantityForm) }}
                                </div>
                            {% endfor %}
                        </div>
                        {% do form.quantities.setRendered() %}
                    </div>


                    <div class="flex justify-end pt-6 border-t border-gray-100">
                        {{ form_widget(form.Ajouter, { label: 'Enregistrer les modifications', attr: { class: 'px-8 py-3 bg-gradient-to-r from-amber-600 to-orange-500 text-white font-semibold rounded-full shadow-md hover:shadow-lg transition cursor-pointer' } }) }}
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
