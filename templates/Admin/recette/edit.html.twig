{% extends 'Admin/adminbase.html.twig' %}
{% block title %}
    Modification de recette
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8 mt-16">
        <div class="max-w-4xl mx-auto">

            {# En-tête #}
            <div class="text-center mb-2">
                <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900">
                    Modification de recette
                </h1>
                <p class="mt-2 text-lg text-gray-600 max-w-2xl mx-auto">
                    Partagez votre recette avec la communauté. Remplissez tous les champs et laissez parler votre créativité !
                </p>
            </div>

            {# Lien retour vers la liste #}
            <div class="mb-2">
                <a href="{{ path('admin.recipe.index') }}"
                    class="text-amber-600 hover:text-amber-800 transition font-medium">
                    ← Retour à la liste des recettes
                </a>
            </div>
            {# Carte du formulaire #}
            <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">

                {# En-tête de la carte avec dégradé #}
                <div class="bg-linear-to-r from-amber-600 to-orange-500 px-8 py-4">
                    <h2 class="text-2xl font-semibold text-white flex items-center gap-2">
                        Nouvelle recette
                    </h2>
                </div>

                {# Corps du formulaire #}
                <div class="px-8 py-8">

                    {{ form_start(form, { attr: { class: 'space-y-6' } }) }}

                    {# Champ Titre #}
                    <div>
                        {{ form_label(form.title, 'Titre de la recette', { label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' } }) }}
                        {{ form_widget(form.title, { attr: {
                        class: 'w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition',
                        placeholder: 'Ex: Omelette aux légumes...'
                        } }) }}
                        {{ form_errors(form.title, { attr: { class: 'text-red-600 text-sm mt-1' } }) }}
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        <div>
                            {{ form_label(form.slug, 'Slug ', { label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' } }) }}
                            <div class="relative">
                                {{ form_widget(form.slug, { attr: {
                                class: 'w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition bg-gray-50',
                                placeholder: 'auto-génération possible',
                                } }) }}
                            </div>
                            {{ form_errors(form.slug, { attr: { class: 'text-red-600 text-sm mt-1' } }) }}
                        </div>


                        <div>
                            {{ form_label(form.duration, 'Durée (en minutes)', { label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' } }) }}
                            {{ form_widget(form.duration, { attr: {
                            class: 'w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition',
                            placeholder: 'Ex: 15',
                            min: 1
                            } }) }}
                            {{ form_errors(form.duration, { attr: { class: 'text-red-600 text-sm mt-1' } }) }}
                        </div>
                    </div>

                    {# Champ Contenu (textarea) #}
                    <div>
                        {{ form_label(form.content, 'Contenu de la recette', { label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' } }) }}
                        {{ form_widget(form.content, { attr: {
                        class: 'w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition',
                        rows: 8,
                        placeholder: 'Décrivez les étapes, les ingrédients, les astuces...'
                        } }) }}
                        {{ form_errors(form.content, { attr: { class: 'text-red-600 text-sm mt-1' } }) }}
                    </div>

                    <div>
                        {{ form_label(form.category, 'Catégorie de la Recette', { label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' } }) }}
                        {{ form_widget(form.category, { attr: {
                        class: 'w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition',
                        placeholder: 'Selectionner la catégorie de la recette'
                        } }) }}
                        {{ form_errors(form.category, { attr: { class: 'text-red-600 text-sm mt-1' } }) }}
                    </div>

                    {# Bouton d'envoi #}
                    <div class="flex justify-end pt-4">
                        {{ form_widget(form.Ajouter, {
                        label: 'Publier la recette',
                        attr: {
                        class: 'inline-flex items-center gap-2 px-8 py-3 bg-gradient-to-r from-amber-600 to-orange-500 text-white font-semibold rounded-full shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5'
                        }
                        }) }}
                    </div>

                    {{ form_end(form) }}

                </div> {# fin div.px-8.py-8 #}
            </div> {# fin carte #}


        </div> {# fin max-w-4xl #}
    </div>
{% endblock %}
