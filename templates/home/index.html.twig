{% extends 'base.html.twig' %}

{% block title %}
    Accueil - Recette App
{% endblock %}

{% block body %}
    <div class="bg-gray-50">

        {# ============================================ #}
        {# 1. HERO (section principale)                  #}
        {# ============================================ #}
        <section class="relative bg-linear-to-r from-amber-600 to-orange-500 text-white">
            <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 md:pt-36 pb-36 md:pb-44">
                <div class="grid md:grid-cols-2 gap-12 items-center">
                    <div>
                        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight">
                            {{ 'Cooking'|trans }} <br/> {{ 'Just a Click Away'|trans }}
                        </h1>
                        <p class="mt-4 text-lg md:text-xl text-white/90 max-w-lg">
                            Découvrez des recettes authentiques, testées et approuvées par notre communauté.
                            Partagez vos créations culinaires et inspirez-vous.
                        </p>
                        <div class="mt-8 flex flex-wrap gap-4">
                            <a href="{{ path('recipe.index') }}"
                                class="px-7 py-3.5 bg-white text-amber-600 hover:bg-amber-50 font-bold rounded-xl shadow-lg hover:shadow-xl transition transform hover:-translate-y-0.5">
                                Explorer les recettes
                            </a>
                        </div>
                    </div>

                    <div class="hidden md:flex justify-center">
                        <img src="https://cdn-icons-png.flaticon.com/512/3075/3075977.png"
                            alt="Cuisine illustration"
                            class="w-64 h-64 object-contain drop-shadow-2xl">
                    </div>

                </div>
            </div>

            {# Vague décorative en bas #}
            <div class="absolute bottom-0 left-0 right-0 overflow-hidden leading-none pointer-events-none z-0">
                <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto block">
                    <path d="M0 120L48 100C96 80 192 40 288 30C384 20 480 40 576 50C672 60 768 60 864 50C960 40 1056 20 1152 20C1248 20 1344 40 1392 50L1440 60V120H1392C1344 120 1248 120 1152 120C1056 120 960 120 864 120C768 120 672 120 576 120C480 120 384 120 288 120C192 120 96 120 48 120H0Z"
                        fill="#F9FAFB"/>
                </svg>
            </div>
        </section>

            {# ============================================ #}
            {# 2. DERNIÈRES RECETTES                        #}
            {# ============================================ #}
            {% if latestRecipes is defined and latestRecipes is not empty %}
                <section class="bg-gray-50 py-12 pb-20">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                        <div class="flex justify-between items-center mb-8">
                            <div>
                                <h2 class="text-2xl md:text-3xl font-bold text-gray-900">
                                    Dernières recettes
                                </h2>
                                <p class="text-sm text-gray-500 mt-1">Les nouveautés culinaires récemment partagées</p>
                            </div>
                            <a href="{{ path('recipe.index') }}"
                                class="inline-flex items-center gap-1.5 text-amber-600 hover:text-amber-800 font-semibold text-sm hover:underline">
                                Voir toutes
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                            </a>
                        </div>

                        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                            {% for recipe in latestRecipes %}
                                <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition border border-gray-100 flex flex-col justify-between group">
                                    <div>
                                        {% if recipe.image %}
                                            <div class="h-48 overflow-hidden bg-amber-50">
                                                {% if 'http' in recipe.image %}
                                                    <img src="{{ recipe.image }}" alt="{{ recipe.title }}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                                                {% else %}
                                                    <img src="{{ vich_uploader_asset(recipe, 'imageFile') }}" alt="{{ recipe.title }}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                        <div class="p-6">
                                            <div class="flex items-center justify-between gap-2 mb-2">
                                                <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-50 text-amber-700">
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                    </svg>
                                                    {{ recipe.duration }} min
                                                </span>
                                                {% if recipe.category %}
                                                    <span class="text-xs text-gray-500 font-medium">
                                                        {{ recipe.category.name }}
                                                    </span>
                                                {% endif %}
                                            </div>
                                            <h3 class="text-lg font-bold text-gray-900 group-hover:text-amber-600 transition">
                                                <a href="{{ path('recipe.show', {slug: recipe.slug, id: recipe.id}) }}">
                                                    {{ recipe.title }}
                                                </a>
                                            </h3>
                                            <p class="text-gray-600 text-sm mt-2 line-clamp-2">
                                                {{ recipe.content|striptags|slice(0, 100) }}…
                                            </p>
                                        </div>
                                    </div>
                                    <div class="px-6 pb-6 pt-0">
                                        <a href="{{ path('recipe.show', {slug: recipe.slug, id: recipe.id}) }}"
                                            class="text-amber-600 hover:text-amber-700 text-sm font-semibold inline-flex items-center gap-1">
                                            Découvrir la recette →
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </section>
            {% endif %}

        </div>
    {% endblock %}
