{% extends 'base.html.twig' %}

{% block title %}Inscription — Recette App{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 ">
    <div class="max-w-md w-full">

        {# Logo ou titre #}
        <div class="text-center">
            <h1 class="text-4xl font-extrabold text-gray-900">
                 Recette App
            </h1>
            <p class="mt-2 text-gray-600">Rejoignez notre communauté de passionnés</p>
        </div>

        {# Carte du formulaire #}
        <div class="mt-8 bg-white rounded-2xl shadow-xl border border-gray-100 p-8">

            {# Messages flash #}
            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg flex items-center gap-3">
                    <span class="text-2xl"></span>
                    {{ flash_error }}
                </div>
            {% endfor %}

            {# Erreurs du formulaire #}
            {{ form_errors(registrationForm) }}

            {# Formulaire d'inscription #}
            {{ form_start(registrationForm, { attr: { class: 'space-y-6' } }) }}

                {# Champ Nom d'utilisateur #}
                <div>
                    {{ form_label(registrationForm.username, 'Nom d\'utilisateur', {
                        label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
                    }) }}
                    {{ form_widget(registrationForm.username, {
                        attr: {
                            class: 'w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition',
                            placeholder: 'Choisissez un username'
                        }
                    }) }}
                    {{ form_errors(registrationForm.username, { attr: { class: 'text-red-600 text-sm mt-1' } }) }}
                </div>

                {# Champ Email #}
                <div>
                    {{ form_label(registrationForm.email, 'Adresse email', {
                        label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
                    }) }}
                    {{ form_widget(registrationForm.email, {
                        attr: {
                            class: 'w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition',
                            placeholder: 'votre@email.com'
                        }
                    }) }}
                    {{ form_errors(registrationForm.email, { attr: { class: 'text-red-600 text-sm mt-1' } }) }}
                </div>

                {# Champ Mot de passe #}
                <div>
                    {{ form_label(registrationForm.plainPassword, 'Mot de passe', {
                        label_attr: { class: 'block text-sm font-medium text-gray-700 mb-1' }
                    }) }}
                    {{ form_widget(registrationForm.plainPassword, {
                        attr: {
                            class: 'w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition',
                            placeholder: '••••••••'
                        }
                    }) }}
                    {{ form_errors(registrationForm.plainPassword, { attr: { class: 'text-red-600 text-sm mt-1' } }) }}
                </div>

                {# Conditions d'utilisation (checkbox) #}
                <div class="flex items-start">
                    <div class="flex items-center h-5">
                        {{ form_widget(registrationForm.agreeTerms, {
                            attr: {
                                class: 'h-4 w-4 text-amber-600 focus:ring-amber-500 border-gray-300 rounded'
                            }
                        }) }}
                    </div>
                    <div class="ml-3 text-sm">
                        {{ form_label(registrationForm.agreeTerms, "J'accepte les conditions d'utilisation", {
                            label_attr: { class: 'text-gray-700' }
                        }) }}
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>
                </div>

                {# Bouton d'inscription #}
                <button type="submit"
                        class="w-full flex justify-center items-center gap-2 px-8 py-3 bg-linear-to-r from-amber-600 to-orange-500 text-white font-semibold rounded-full shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5">
                     Créer mon compte
                </button>

                {# Lien vers la connexion #}
                <div class="text-center text-sm text-gray-600 mt-4">
                    Déjà un compte ?
                    <a href="{{ path('app_login') }}"
                       class="text-amber-600 hover:text-amber-800 font-medium hover:underline">
                        Connectez-vous
                    </a>
                </div>

            {{ form_end(registrationForm) }}
        </div>

        {# Footer #}
        <div class="mt-6 text-center text-sm text-gray-400">
            © {{ "now"|date("Y") }} Recette App
        </div>
    </div>
</div>
{% endblock %}
