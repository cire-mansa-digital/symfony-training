<nav class="bg-amber-600 fixed w-full z-50 top-0 shadow-md">
    <div class="max-w-7xl flex flex-wrap items-center justify-between mx-auto p-4">

        {# Logo #}
        <a href="{{ path('Home') }}" class="flex items-center space-x-3">
            <img src="https://png.pngtree.com/png-vector/20230614/ourmid/pngtree-cooking-logo-vector-png-image_7136422.png"
                class="h-10" alt="Logo Recette App">
                <span class="text-2xl text-white font-bold whitespace-nowrap">Recette App</span>
            </a>

            {# Bouton menu mobile (hamburger) #}
            <button id="menu-toggle" type="button"
                class="inline-flex items-center p-2 w-10 h-10 justify-center text-white rounded-lg md:hidden hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-white transition">
                <span class="sr-only">Ouvrir le menu</span>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h14"/>
                </svg>
            </button>

            {# Menu #}
            <div class="hidden w-full md:block md:w-auto" id="navbar-default">
                <ul class="font-medium flex flex-col p-4 md:p-0 mt-4 md:flex-row md:space-x-2 md:mt-0 items-center">


                    {# Recettes #}
                    <li>
                        <a href="{{ path('admin.recipe.index') }}"
                            class="block py-2 px-4 rounded-lg text-white transition hover:bg-amber-700 {{ app.current_route starts with 'admin.recipe.' ? 'bg-amber-700 font-semibold' : '' }}">
                            Mes Recettes
                        </a>
                    </li>
                    {% if is_granted('ROLE_ADMIN') %}
                        <li>
                            <a href="{{ path('admin.category.index') }}"
                                class="block py-2 px-4 rounded-lg text-white transition hover:bg-amber-700 {{ app.current_route starts with 'admin.category.' ? 'bg-amber-700 font-semibold' : '' }}">
                                Gestions Catégories
                            </a>
                        </li>
                    {% endif %}



                    {# ============================================ #}
                    {# ZONE AUTHENTIFICATION                         #}
                    {# ============================================ #}

                    {% if app.user %}
                        {# ----- Utilisateur CONNECTÉ ----- #}

                        {# Dropdown utilisateur #}
                        <li class="relative" id="user-dropdown">
                            <button type="button"
                                class="flex items-center gap-2 py-2 px-4 rounded-lg text-white hover:bg-amber-700 transition">
                                <span class="w-8 h-8 rounded-full bg-white text-amber-600 flex items-center justify-center font-bold">
                                    {{ app.user.userIdentifier|first|upper }}
                                </span>
                                <span class="font-medium">{{ app.user.userIdentifier }}</span>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                </svg>
                            </button>

                            {# Menu déroulant #}
                            <div id="user-menu"
                                class="hidden absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-xl border border-gray-100 py-2 z-50">
                                <div class="px-4 py-3 border-b border-gray-100">
                                    <p class="text-sm font-semibold text-gray-900">{{ app.user.userIdentifier }}</p>
                                    <p class="text-xs text-gray-500 truncate">{{ app.user.email ?? '' }}</p>
                                </div>

                                <div class="border-t border-gray-100 my-1"></div>

                                <a href="{{ logout_path() }}"
                                    class="flex items-center gap-2 px-4 py-2 text-red-600 hover:bg-red-50 transition">
                                    Se déconnecter
                                </a>
                            </div>
                        </li>


                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    {# ============================================ #}
    {# Scripts pour le menu mobile + dropdown       #}
    {# ============================================ #}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Toggle menu mobile
            const menuToggle = document.getElementById('menu-toggle');
            const navbar = document.getElementById('navbar-default');
            if (menuToggle && navbar) {
                menuToggle.addEventListener('click', () => {
                    navbar.classList.toggle('hidden');
                });
            }

            // Toggle dropdown utilisateur
            const userDropdownBtn = document.querySelector('#user-dropdown > button');
            const userMenu = document.getElementById('user-menu');
            if (userDropdownBtn && userMenu) {
                userDropdownBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    userMenu.classList.toggle('hidden');
                });

                // Fermer le menu si on clique ailleurs
                document.addEventListener('click', (e) => {
                    if (!userMenu.contains(e.target) && !userDropdownBtn.contains(e.target)) {
                        userMenu.classList.add('hidden');
                    }
                });
            }
        });




        document.addEventListener('turbo:load', initMenu);
        document.addEventListener('DOMContentLoaded', initMenu);

        function initMenu() {
            // Toggle dropdown utilisateur
            const userDropdownBtn = document.querySelector('#user-dropdown > button');
            const userMenu = document.getElementById('user-menu');
            if (userDropdownBtn && userMenu) {
                userDropdownBtn.onclick = (e) => {
                    e.stopPropagation();
                    userMenu.classList.toggle('hidden');
                };

                document.onclick = (e) => {
                    if (!userMenu.contains(e.target) && !userDropdownBtn.contains(e.target)) {
                        userMenu.classList.add('hidden');
                    }
                };
            }
        }

    </script>
