{% extends 'base.html.twig' %}

{% block title %}Connexion {% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 ">
    <div class="max-w-md w-full">


        <div class="text-center">
            <h1 class="text-4xl font-extrabold text-gray-900">
                 Recette App
            </h1>
            <p class="mt-2 text-gray-600">Connectez-vous pour accéder à votre espace</p>
        </div>

        {# Carte du formulaire #}
        <div class="mt-8 bg-white rounded-2xl shadow-xl border border-gray-100 p-8">

            {# Affichage des erreurs #}
            {% if error %}
                <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg flex items-center gap-3">
                    <span class="text-2xl">⚠️</span>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}



            {# Formulaire de connexion #}
            <form method="post" class="space-y-6">

                {# Champ Username #}
                <div>
                    <label for="inputUsername" class="block text-sm font-medium text-gray-700 mb-1">
                        Nom d'utilisateur
                    </label>
                    <input type="text"
                           value="{{ last_username }}"
                           name="username"
                           id="inputUsername"
                           autocomplete="username"
                           required
                           autofocus
                           class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition"
                           placeholder="Votre nom d'utilisateur">
                </div>

                {# Champ Password #}
                <div>
                    <label for="inputPassword" class="block text-sm font-medium text-gray-700 mb-1">
                        Mot de passe
                    </label>
                    <input type="password"
                           name="password"
                           id="inputPassword"
                           autocomplete="current-password"
                           required
                           class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition"
                           placeholder="••••••••">
                </div>

                {# Token CSRF #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                {# Case à cocher "Se souvenir de moi" #}
                <div class="flex items-center">
                    <input type="checkbox"
                           name="_remember_me"
                           id="rememberMe"
                           class="h-4 w-4 text-amber-600 focus:ring-amber-500 border-gray-300 rounded">
                    <label for="rememberMe" class="ml-2 block text-sm text-gray-700">
                        Se souvenir de moi
                    </label>
                </div>

                {# Bouton de connexion #}
                <button type="submit"
                        class="w-full flex justify-center items-center gap-2 px-8 py-3 bg-linear-to-r from-amber-600 to-orange-500 text-white font-semibold rounded-full shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5">
                     Se connecter
                </button>

                {# Lien vers l'inscription #}
                <div class="text-center text-sm text-gray-600 mt-4">
                    Pas encore de compte ?
                    <a href=" {{path('app_register')}} " class="text-amber-600 hover:text-amber-800 font-medium hover:underline">
                        Créez-en un maintenant
                    </a>
                </div>
            </form>
        </div>

        {# Footer #}
        <div class="mt-6 text-center text-sm text-gray-400">
            © {{ "now"|date("Y") }} Recette App
        </div>
    </div>
</div>
{% endblock %}
