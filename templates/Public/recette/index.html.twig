{% extends 'base.html.twig' %}

{% block title %}Toutes nos recettes — Recette App{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 pt-24 pb-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">

        {# En-tête #}
        <div class="text-center mb-12">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 mb-3">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
                Catalogue de saveurs
            </span>
            <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight">
                Toutes nos recettes
            </h1>
            <p class="mt-3 text-lg text-gray-600 max-w-2xl mx-auto">
                Découvrez notre sélection de recettes gourmandes, testées et approuvées par la communauté.
            </p>
            {% if recipes.getTotalItemCount is defined %}
                <p class="mt-2 text-sm font-medium text-amber-700">
                    {{ recipes.getTotalItemCount }} recette{{ recipes.getTotalItemCount > 1 ? 's' : '' }} au total
                </p>
            {% endif %}
        </div>

        {# Grille des recettes #}
        {% if recipes is not empty and recipes|length > 0 %}
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {% for recipe in recipes %}
                    <div class="group bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 flex flex-col justify-between transform hover:-translate-y-1">
                        <div>
                            {# Photo de la recette avec zoom au survol #}
                            <div class="relative h-56 w-full overflow-hidden bg-linear-to-br from-amber-50 to-orange-100">
                                {% if recipe.image %}
                                    {% if 'http' in recipe.image %}
                                        <img src="{{ recipe.image }}" alt="{{ recipe.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out">
                                    {% else %}
                                        <img src="{{ vich_uploader_asset(recipe, 'imageFile') }}" alt="{{ recipe.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out">
                                    {% endif %}
                                {% else %}
                                    <div class="w-full h-full flex flex-col items-center justify-center text-amber-300">
                                        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </svg>
                                        <span class="text-xs font-medium text-amber-500 mt-1">Photo à venir</span>
                                    </div>
                                {% endif %}

                                {# Badge Catégorie flottant #}
                                {% if recipe.category %}
                                    <span class="absolute top-3 left-3 inline-flex items-center px-3 py-1 bg-white/90 backdrop-blur-md text-amber-800 font-semibold text-xs rounded-full shadow-sm">
                                         {{ recipe.category.name }}
                                    </span>
                                {% endif %}
                            </div>

                            {# Contenu de la carte #}
                            <div class="p-6">
                                {# Badges Durée & Ingrédients #}
                                <div class="flex flex-wrap items-center gap-2 mb-3">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-amber-50 text-amber-800 text-xs font-semibold rounded-lg">
                                         {{ recipe.duration }} min
                                    </span>

                                    {% if recipe.quantities is defined %}
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-gray-100 text-gray-700 text-xs font-semibold rounded-lg">
                                             {{ recipe.quantities|length }} ingrédient{{ recipe.quantities|length > 1 ? 's' : '' }}
                                        </span>
                                    {% endif %}
                                </div>

                                {# Titre #}
                                <h2 class="text-xl font-bold text-gray-900 group-hover:text-amber-600 transition line-clamp-1">
                                    <a href="{{ path('recipe.show', {slug: recipe.slug, id: recipe.id}) }}">
                                        {{ recipe.title }}
                                    </a>
                                </h2>

                                {# Description avec line-clamp #}
                                <p class="text-gray-600 text-sm mt-2.5 line-clamp-3 leading-relaxed">
                                    {{ recipe.content|striptags }}
                                </p>
                            </div>
                        </div>

                        {# Footer de la carte avec Bouton d'action #}
                        <div class="px-6 pb-6 pt-0">
                            <a href="{{ path('recipe.show', {slug: recipe.slug, id: recipe.id}) }}"
                               class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-amber-500 group-hover:bg-amber-600 text-white font-semibold text-sm rounded-xl shadow-sm group-hover:shadow-md transition duration-200">
                                <span>Découvrir la recette</span>
                                <svg class="w-4 h-4 transform group-hover:translate-x-1 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {# Pagination KnpPaginator #}
            <div class="mt-12 flex justify-center">
                {{ knp_pagination_render(recipes) }}
            </div>

        {% else %}
            {# État vide #}
            <div class="text-center py-20 bg-white rounded-3xl border border-gray-100 shadow-sm max-w-lg mx-auto">
                <div class="w-20 h-20 mx-auto mb-4 bg-amber-50 rounded-full flex items-center justify-center text-amber-500">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">Aucune recette trouvée</h3>
                <p class="text-gray-500 text-sm max-w-sm mx-auto">
                    Il n'y a pas encore de recette publiée pour le moment. Revenez très bientôt !
                </p>
            </div>
        {% endif %}

    </div>
</div>
{% endblock %}
