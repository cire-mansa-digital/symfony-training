{% extends 'base.html.twig' %}

{% block title %}
    {{ recipe.title }} — Recette App
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8 mt-16">
        <div class="max-w-4xl mx-auto">

            {# Fil d'Ariane / Lien retour #}
            <div class="mb-6">
                <a href="{{ path('recipe.index') }}"
                    class="inline-flex items-center gap-2 text-amber-600 hover:text-amber-800 transition font-medium">
                    ← Retour à toutes les recettes
                </a>
            </div>

            {# Carte principale #}
            <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">

                {# En-tête avec dégradé #}
                <div class="bg-gradient-to-r from-amber-600 to-orange-500 px-8 py-6">
                    <div class="flex flex-wrap items-start justify-between gap-4">
                        <div>
                            <h1 class="text-3xl md:text-4xl font-extrabold text-white">
                                {{ recipe.title }}
                            </h1>
                            <p class="text-white/80 text-sm mt-1">
                                Slug : {{ recipe.slug }}
                            </p>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="inline-flex items-center gap-1.5 px-4 py-2 bg-white/20 backdrop-blur-sm text-white font-semibold rounded-full text-sm">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                {{ recipe.duration }} min
                            </span>
                            {% if recipe.category %}
                                <span class="inline-flex items-center px-3.5 py-1.5 bg-white text-amber-700 font-semibold rounded-full text-xs shadow-xs">
                                    {{ recipe.category.name }}
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# Corps #}
                <div class="px-8 py-6 space-y-8">

                    {# Métadonnées #}
                    <div class="flex flex-wrap gap-6 text-sm text-gray-500 border-b border-gray-100 pb-4">
                        <span class="flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            Publiée le {{ recipe.createdAt|date('d/m/Y') }}
                        </span>
                        {% if recipe.updateAt %}
                            <span class="flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                </svg>
                                Mise à jour le {{ recipe.updateAt|date('d/m/Y') }}
                            </span>
                        {% endif %}
                    </div>

                    {# Image #}
                    {% if recipe is defined and recipe.image %}
                        <div>
                            {% if 'http' in recipe.image %}
                                <img src="{{ recipe.image }}" alt="{{ recipe.title }}" class="w-full max-h-96 object-cover rounded-xl border border-gray-200 shadow-sm">
                            {% else %}
                                <img src="{{ vich_uploader_asset(recipe, 'imageFile') }}" alt="{{ recipe.title }}" class="w-full max-h-96 object-cover rounded-xl border border-gray-200 shadow-sm">
                            {% endif %}
                        </div>
                    {% endif %}

                    {# Ingrédients & Quantités #}
                    {% if recipe.quantities is defined and recipe.quantities|length > 0 %}
                        <div class="bg-amber-50/50 rounded-2xl p-6 border border-amber-100/80">
                            <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                                <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                                </svg>
                                Ingrédients ({{ recipe.quantities|length }})
                            </h2>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                                {% for qty in recipe.quantities %}
                                    <div class="flex items-center justify-between p-3.5 bg-white rounded-xl border border-amber-100 shadow-xs hover:shadow-sm transition">
                                        <span class="font-medium text-gray-800">
                                            {{ qty.ingredient ? qty.ingredient.name : 'Ingrédient' }}
                                        </span>
                                        <span class="inline-flex items-center px-2.5 py-1 bg-amber-100 text-amber-800 text-xs font-semibold rounded-lg">
                                            {{ qty.quantity }} {{ qty.unit }}
                                        </span>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {# Description / Instructions #}
                    <div class="prose prose-lg max-w-none">
                        <h2 class="text-xl font-bold text-gray-900 mb-3 flex items-center gap-2">
                            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            Préparation
                        </h2>
                        <div class="text-gray-700 leading-relaxed whitespace-pre-line bg-gray-50/50 p-6 rounded-2xl border border-gray-100">
                            {{ recipe.content|nl2br }}
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
{% endblock %}
