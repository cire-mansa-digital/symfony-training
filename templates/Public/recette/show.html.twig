{% extends 'base.html.twig' %}

{% block title %}{{ recipe.title }} — Recette App{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8 mt-16">
    <div class="max-w-4xl mx-auto">

        {# Fil d'Ariane / Lien retour #}
        <div class="mb-6">
            <a href="{{ path('recipe.index') }}"
               class="text-amber-600 hover:text-amber-800 transition font-medium">
                ← Retour à toutes les recettes
            </a>
        </div>

        {# Carte principale #}
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">

            {# En-tête avec dégradé #}
            <div class="bg-linear-to-r from-amber-600 to-orange-500 px-8 py-6">
                <div class="flex flex-wrap items-start justify-between gap-4">
                    <h1 class="text-3xl md:text-4xl font-extrabold text-white">
                        {{ recipe.title }}
                    </h1>
                    <div class="flex items-center gap-3">
                        <span class="inline-flex items-center gap-1 px-4 py-2 bg-white/20 backdrop-blur-sm text-white font-semibold rounded-full text-sm">
                             {{ recipe.duration }} min
                        </span>
                    </div>
                </div>
                <p class="text-white/70 text-sm mt-2">
                     Slug : {{ recipe.slug }}
                </p>
            </div>

            {# Corps #}
            <div class="px-8 py-6">

                {# Métadonnées #}
                <div class="flex flex-wrap gap-6 text-sm text-gray-500 border-b border-gray-100 pb-4 mb-6">
                    <span class="flex items-center gap-1">
                         Créée le {{ recipe.createdAt|date('d/m/Y à H:i') }}
                    </span>
                    {% if recipe.updateAt %}
                        <span class="flex items-center gap-1">
                             Modifiée le {{ recipe.updateAt|date('d/m/Y à H:i') }}
                        </span>
                    {% endif %}
                    <span class="flex items-center gap-1">

                    </span>
                </div>

                {# Contenu #}
                <div class="prose prose-lg max-w-none">
                    <h2 class="text-xl font-semibold text-gray-800 mb-3"> Description</h2>
                    <div class="text-gray-700 leading-relaxed whitespace-pre-line">
                        {{ recipe.content|nl2br }}
                    </div>
                </div>

                {# Actions (si l'utilisateur est admin, on peut les afficher) #}

            </div>
        </div>


    </div>
</div>
{% endblock %}
